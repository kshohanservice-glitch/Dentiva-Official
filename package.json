{
  "name": "dentiva-pro",
  "productName": "Dentiva Pro",
  "version": "1.0.0",
  "description": "Dentiva Pro — premium offline-first dental clinic / dental practice management system for Windows.",
  "author": {
    "name": "Shohan Khan",
    "email": "helloiamshohan@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:node && node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:api": "npm run build:node && node out/scripts/dev-host.js",
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest run tests/ui",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run typecheck:node && npm run test && npm run build",
    "stress": "npm run build:node && node out/scripts/stress.js",
    "pack:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "node-sqlite3-wasm": "0.8.60"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "38.3.0",
    "electron-builder": "26.0.12",
    "jsdom": "26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
